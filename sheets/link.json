{
  "sheet": "link",
  "about": "The shared-memory link between Vampire Survivors (the VS mod) and the hidden ROUNDS (the engine), one block named Local\\VampireRoundsArena1. Each row is one field: block + offset make its address; the generated ArenaLink constants (src/Shared/Generated/Link.g.cs) come from these rows. Control = VS writes, ROUNDS reads; result = ROUNDS writes, VS reads; per-seat blocks repeat for seat 0 (Orange, ROUNDS player 0) and seat 1 (Blue, ROUNDS player 1); ring entries repeat inside their ring. Counters only go up, so no press, hit or event is lost.",
  "columns": {
    "id": "constant name in ArenaLink",
    "block": "layout | control | seat | event | pick | target | result | rseat | hit | fx | status",
    "offset": "byte offset inside its block (layout rows: the value itself)",
    "type": "int | float | const",
    "writer": "vs | rounds | both | none (layout constants)",
    "meaning": "what the field holds"
  },
