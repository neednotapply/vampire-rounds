<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Vampire Rounds launcher Melty starts: Thunderstore ROUNDS card mods, then Play. .NET Framework 4.8 ships with
       Windows 10/11, so players need nothing extra. Adapted from Roundhead's launcher (MIT, the same creator). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VampireRoundsLauncher</AssemblyName>
    <RootNamespace>VampireRounds.Launcher</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon />
    <Product>Vampire Rounds</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- The face file format the engine reads too. -->
    <Compile Include="..\Shared\FaceFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
