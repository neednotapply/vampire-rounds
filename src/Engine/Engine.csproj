<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vampire Rounds engine: a BepInEx 5 plugin for the player's own ROUNDS (old-rounds-for-mods branch, Unity 2018.4 Mono). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VampireRounds.Engine</AssemblyName>
    <RootNamespace>VampireRounds</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ENGINE</DefineConstants>
    <NoWarn>CS1591;CS0649;CS0169;CS0414</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RoundsDir Condition="'$(RoundsDir)' == ''">D:\SteamLibrary\steamapps\common\ROUNDS</RoundsDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(USERPROFILE)\vsr-work\dl\bepinex\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <RoundsManaged Include="$(RoundsDir)\Rounds_Data\Managed\*.dll" Exclude="$(RoundsDir)\Rounds_Data\Managed\mscorlib.dll;$(RoundsDir)\Rounds_Data\Managed\System*.dll;$(RoundsDir)\Rounds_Data\Managed\Mono.*.dll;$(RoundsDir)\Rounds_Data\Managed\netstandard.dll;$(RoundsDir)\Rounds_Data\Managed\Microsoft.*.dll" />
    <Reference Include="@(RoundsManaged->'%(FullPath)')" Private="false" />
  </ItemGroup>
</Project>
